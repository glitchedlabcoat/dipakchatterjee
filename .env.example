# .env.example — every setting this app reads, and where each one goes.
#
# There are only two real places, never a committed file:
#
#   LOCAL   Copy this file to .env.local (gitignored, never commit it)
#           and fill in real values. Only needed to run `npm run dev` or
#           `npm run build` on your own machine. A plain `.env` is not
#           needed; if both exist, .env.local wins.
#
#   RENDER  Render never reads a .env file. Production values live in
#           the Render dashboard -> the web service -> Environment.
#
# Tags on each setting below:
#   [LOCAL + RENDER]  required in both places
#   [RENDER ONLY]     set in the dashboard; leave out of .env.local
#   [OPTIONAL]        leave blank unless you want that feature
#
# Quick checklist:
#   Required, both:   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                     SUPABASE_SERVICE_ROLE_KEY, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
#                     R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_DOMAIN,
#                     R2_COMPLAINT_BUCKET_NAME, APP_ENCRYPTION_KEY
#   Render only:      NODE_OPTIONS, HOSTNAME
#   Optional:         CLOUDFLARE_API_TOKEN, CRON_SECRET, ENABLE_ADMIN_2FA,
#                     RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_WEBHOOK_SECRET,
#                     SMS_PROVIDER, FAST2SMS_API_KEY, TWILIO_ACCOUNT_SID,
#                     TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER
#   (The email system needs the RESEND_* trio plus CRON_SECRET; see
#   docs/email-system.md.)

# --- Supabase ---------------------------------------------------------------

# [LOCAL + RENDER] Project URL and anon (public) key — safe to expose to
# the client; every table they can touch is protected by Row Level
# Security. Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [LOCAL + RENDER] Service-role key — bypasses Row Level Security
# entirely. Server-only. Used exclusively so an anonymous citizen can
# submit a complaint (see utils/supabase/admin.ts for why). Never prefix
# with NEXT_PUBLIC_, never import from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (primary object storage for media uploads) ---------------

# [LOCAL + RENDER] Supabase remains Postgres-only; image/video uploads go
# to R2 (see lib/r2.ts). Find these under Cloudflare dashboard -> R2 ->
# Manage API Tokens (account ID is also shown on the R2 overview page).
# Server-only — never prefix with NEXT_PUBLIC_, never import lib/r2.ts
# from a "use client" file.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# [LOCAL + RENDER] The bucket created for this app's public media.
R2_BUCKET_NAME=
# [LOCAL + RENDER] That bucket's public hostname — either R2's own r2.dev
# subdomain (bucket Settings -> Public Access) or a custom domain
# connected to it. Host only, no https://, e.g. pub-xxxxxxxx.r2.dev.
R2_PUBLIC_DOMAIN=

# [LOCAL + RENDER] A SECOND, SEPARATE R2 bucket for citizen complaint
# attachments (see lib/r2-complaints.ts). Must NOT have public access or
# a custom domain — Cloudflare's public-access toggle is bucket-wide, and
# this bucket holds private submissions. Every read/write goes through
# short-lived presigned URLs. Reuses the three R2 credentials above.
R2_COMPLAINT_BUCKET_NAME=

# [OPTIONAL] Only for /admin/usage's Advanced-mode "Live Cloudflare R2
# metrics" panel (Class A/B operation counts); everything else on that
# dashboard works without it. Cloudflare dashboard -> My Profile -> API
# Tokens, with "Account Analytics: Read" on this account. Left unset,
# that one panel shows as not connected.
CLOUDFLARE_API_TOKEN=

# --- Server secrets ---------------------------------------------------------

# [LOCAL + RENDER] Required for admin login: HMAC-signs the OTP session
# cookie (lib/otp-session.ts) and hashes login OTP codes before they're
# stored (lib/otp.ts) — never the raw code. Use a DIFFERENT value locally
# than on Render, so a leaked local file can't sign production cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# [OPTIONAL, needed for email reminders and retries] Enables
# /api/cron/email (the email scheduler tick) and
# /api/cron/purge-complaints for an external scheduler, which must send
# it as `Authorization: Bearer <secret>`. If unset, both routes return
# 404: no reminders or automatic retries are sent (receipts and
# notifications still go out at submission), and the admin complaints
# page still purges expired complaints every time it loads. The
# documented free scheduler is Supabase pg_cron + pg_net
# (supabase/snippets/email-scheduler-pg-cron.sql), which reads the same
# value from Supabase Vault. Generate it the same way as
# APP_ENCRYPTION_KEY.
CRON_SECRET=

# --- Admin login OTP (2FA) --------------------------------------------------

# [OPTIONAL] "true" requires an emailed 6-digit code after the password
# before granting a dashboard session (see lib/feature-flags.ts). Unset
# or "false", a correct password alone signs you in — the OTP route, UI
# and dispatch code stay in place either way, just unused.
ENABLE_ADMIN_2FA=false

# The emailed code uses RESEND_API_KEY and RESEND_FROM_EMAIL from the
# Email section below; set those before ENABLE_ADMIN_2FA=true on Render.
# With 2FA on and they're unset: production refuses to log in (fails
# closed); local dev prints the code to the terminal instead.

# [OPTIONAL] SMS leg of the OTP — currently switched off in code
# (SMS_OTP_ENABLED in lib/otp-login.ts), so these are unused today. To
# use it: set SMS_PROVIDER to "fast2sms" or "twilio" and fill in that
# provider's variables. Left blank, the first provider with credentials
# set is used.
SMS_PROVIDER=
# Fast2SMS (https://www.fast2sms.com) — India-focused SMS gateway.
FAST2SMS_API_KEY=
# Twilio (https://www.twilio.com) — international SMS gateway.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (Resend) ---------------------------------------------------------

# [OPTIONAL, needed for complaint receipts, office notifications,
# reminders, the admin Emails section, and 2FA] Email via Resend
# (https://resend.com), a plain REST call, no SDK. Full setup, DNS and
# testing notes: docs/email-system.md. Without them the site works and
# simply sends no email.
#
# API key. For the dashboard inbox it needs "Full access"; a
# "Sending access" key can send but can't download received mail.
RESEND_API_KEY=
# Default sender. Its domain must be verified in Resend, and it is also
# treated as the site's mail domain (sender addresses chosen in
# Emails -> Settings must be on it; received mail must be addressed to
# it), e.g.
#   RESEND_FROM_EMAIL=Dipak Chatterjee <office@janatardipak.com>
RESEND_FROM_EMAIL=
# Signing secret (whsec_...) of the Resend webhook pointed at
# https://janatardipak.com/api/webhooks/resend. It carries delivery
# reports and received mail. If unset, that route returns 404.
RESEND_WEBHOOK_SECRET=

# --- Render only (dashboard -> Environment; NOT read from .env.local) -------

# [RENDER ONLY] Render's Node runtime auto-sized V8's heap ceiling to
# ~256MB on this 512MB container, which production logs showed being too
# tight ("FATAL ERROR: JavaScript heap out of memory", exit 134). Node
# reads NODE_OPTIONS before the app starts, so it only works as a real
# dashboard variable.
# NODE_OPTIONS=--max-old-space-size=400

# [RENDER ONLY] Makes the standalone server listen on all interfaces so
# Render can reach it.
# HOSTNAME=0.0.0.0
