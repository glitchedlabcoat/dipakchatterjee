# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# Supabase project URL and anon (public) key — safe to expose to the
# client; every table they can touch is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses Row Level Security entirely. Server-only.
# Used exclusively so an anonymous citizen can submit a complaint (see
# utils/supabase/admin.ts for why). Never prefix with NEXT_PUBLIC_, never
# import from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (primary object storage for media uploads) ---
# Supabase remains Postgres-only; new image/video uploads go to R2
# instead (see lib/r2.ts, app/api/admin/upload/route.ts). Find these
# under Cloudflare dashboard -> R2 -> Manage API Tokens (account ID is
# also shown on the R2 overview page). Server-only — never prefix with
# NEXT_PUBLIC_, never import lib/r2.ts from a "use client" file.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket created for this app's media.
R2_BUCKET_NAME=
# The bucket's public hostname — either R2's own r2.dev subdomain (from
# the bucket's Settings -> Public Access) or a custom domain you've
# connected to it. No protocol/scheme, just the host, e.g.
# media.janatardipak.com or pub-xxxxxxxx.r2.dev.
R2_PUBLIC_DOMAIN=

# A SECOND, SEPARATE R2 bucket for citizen complaint attachments (see
# lib/r2-complaints.ts). Must NOT have public access / a custom domain
# enabled — Cloudflare's public-access toggle is bucket-wide, and unlike
# R2_BUCKET_NAME above, this bucket holds private submissions. Every
# read/write against it goes through short-lived presigned URLs instead.
# Reuses R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY above.
R2_COMPLAINT_BUCKET_NAME=

# Optional. Only needed for /admin/usage's Advanced-mode "Live Cloudflare
# R2 metrics" panel (Class A/B operation counts) — everything else on
# that dashboard (Supabase egress, R2 storage size/object count) works
# without it. Create at Cloudflare dashboard -> My Profile -> API Tokens,
# with "Account Analytics: Read" permission on this account. Left unset,
# that one panel just shows as not connected.
CLOUDFLARE_API_TOKEN=

# Optional: if set, /api/cron/purge-complaints requires this as a
# `Authorization: Bearer <secret>` header. If unset, that route is open
# (acceptable since the operation it performs is idempotent and low-risk
# — it only deletes complaints already past their expiration).
CRON_SECRET=

# Required for admin login: HMAC-signs the OTP session cookie
# (lib/otp-session.ts) and hashes login OTP codes before they're stored
# (lib/otp.ts) — never the raw code. Also available generally for any
# other server-side value that needs to be hashed/signed at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Optional: enables `npm run deploy:push` / `npm run notify:discord` (see
# scripts/notify-discord.js) to post a commit summary to a Discord
# channel after a local push. Create one via a Discord channel's
# Settings -> Integrations -> Webhooks. Leave unset to skip silently.
DISCORD_WEBHOOK_URL=

# --- Admin login OTP (2FA) ---
# Set to "true" to require the emailed 6-digit code before granting a
# dashboard session (see lib/feature-flags.ts). Left unset/"false", a
# correct password alone signs you in immediately — the OTP route, UI,
# and dispatch code below all stay in place either way, just unused.
ENABLE_ADMIN_2FA=false

# When the flag above is on, a 6-digit code is sent to BOTH the admin's
# email and phone at once (see lib/otp-login.ts). Configure email, SMS,
# or both — if NEITHER is set, the OTP challenge is skipped entirely
# rather than locking the admin out with a code that could never be
# delivered. Set the admin's own phone number from the dashboard's
# Settings -> Users & Access tab once at least one channel below is
# configured.

# Email, via Resend (https://resend.com) — a plain REST call, no SDK.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS — set SMS_PROVIDER to "fast2sms" or "twilio" and fill in that
# provider's own variables below. If SMS_PROVIDER is left blank, the
# first provider below with credentials set is used automatically.
SMS_PROVIDER=
# Fast2SMS (https://www.fast2sms.com) — India-focused SMS gateway.
FAST2SMS_API_KEY=
# Twilio (https://www.twilio.com) — international SMS gateway.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
